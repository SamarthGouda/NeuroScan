# ==============================================================================
# NEUROVISION / NEUROSCAN AI — Production Environment Configuration (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#      cp .env.example .env     (Linux/macOS)
#      copy .env.example .env   (Windows)
# 2. Update the values below with your real credentials and secrets.
# 3. DO NOT COMMIT '.env' TO VERSION CONTROL. Keep secrets safe.
# ==============================================================================

# ─── 1. Application & Environment Mode ─────────────────────────────────────────
# Options: 'development' | 'staging' | 'production'
# In 'production', secure cookies (SameSite=Lax, Secure flag) and strict headers are enforced.
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# ─── 2. Cryptographic Security & JWT Signing ───────────────────────────────────
# Generate a cryptographically secure 64-character hex key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
NEUROSCAN_AUTH_SECRET=your-32-byte-hex-secret-key-change-in-production
JWT_SECRET=your-32-byte-hex-secret-key-change-in-production

# Session duration in seconds (Default: 604800 = 7 days)
TOKEN_EXPIRY_SECONDS=604800

# ─── 3. Database Connection ────────────────────────────────────────────────────
# SQLite (default for local development and self-contained deployments):
DATABASE_URL=sqlite:///./neurovision.db

# PostgreSQL (recommended for high-concurrency production deployments):
# DATABASE_URL=postgresql+psycopg2://neurovision_user:your_password@localhost:5432/neurovision_db

# ─── 4. CORS Allowed Origins ──────────────────────────────────────────────────
# Comma-separated list of origins permitted to access the API.
# In production, replace with your exact domain name (e.g., https://neurovision.yourhospital.org)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# ─── 5. File Upload Limit ─────────────────────────────────────────────────────
# Maximum MRI scan upload size in bytes (Default: 26214400 bytes = 25 MB)
MAX_UPLOAD_SIZE_BYTES=26214400

# ─── 6. Google Cloud OAuth 2.0 (Sign in with Google) ──────────────────────────
# How to obtain:
#   1. Go to Google Cloud Console: https://console.cloud.google.com/
#   2. Navigate to "APIs & Services" > "Credentials".
#   3. Create an "OAuth 2.0 Client ID" with application type "Web application".
#   4. Add Authorized JavaScript origins:
#        http://localhost:5173  (development)
#        http://localhost:8000  (development)
#        https://yourdomain.com (production)
#   5. Add Authorized redirect URIs:
#        http://localhost:8000/api/auth/google/callback
#        http://localhost:5173/api/auth/google/callback
#        https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ─── 7. SMTP Email Delivery & OTP Service ─────────────────────────────────────
# Used for verification codes, password reset OTPs, and clinical security alerts.
# If left empty, system operates in local console mode:
#   OTPs are printed to the backend terminal for local developer testing.
# For Gmail SMTP:
#   1. Enable 2-Step Verification on your Google Account.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail" / "NeuroVision AI".
#   4. Paste the 16-character password into SMTP_PASSWORD below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-hospital-or-alert-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=NeuroVision AI <noreply@neurovision.ai>
SMTP_USE_TLS=true
