# ==============================================================================
# NEUROVISION AI — Environment Configuration Example (.env.example)
# Copy this file to .env and replace placeholder values with your real configuration.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# ─── Application & Environment ────────────────────────────────────────────────
ENVIRONMENT=development
# Options: development, staging, production
PORT=8000
HOST=0.0.0.0

# ─── Security & Authentication ────────────────────────────────────────────────
# Generate a secure 32+ character key: python -c "import secrets; print(secrets.token_hex(32))"
NEUROSCAN_AUTH_SECRET=change-this-to-a-super-secret-production-random-key-here
JWT_SECRET=change-this-to-a-super-secret-production-random-key-here
TOKEN_EXPIRY_SECONDS=604800

# ─── Database Configuration ───────────────────────────────────────────────────
# SQLite (default for development):
DATABASE_URL=sqlite:///./neurovision.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://neurovision:neurovision_secure_pass@localhost:5432/neurovision_db

# ─── CORS Allowed Origins (Comma-separated list) ──────────────────────────────
# In production, restrict to your exact domain(s)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# ─── File Upload Limits ───────────────────────────────────────────────────────
# Default: 26214400 bytes (25 MB)
MAX_UPLOAD_SIZE_BYTES=26214400

# ─── Google OAuth 2.0 (Optional for Social Login) ─────────────────────────────
# Obtain from Google Cloud Console: Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ─── SMTP Email / OTP Delivery Configuration (Optional) ───────────────────────
# If left empty, system runs in dev mode: OTP codes are printed to console & logged
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-hospital-or-alert-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@neurovision.ai
SMTP_USE_TLS=true
